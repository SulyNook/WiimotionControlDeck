#!/bin/sh
# Steam injects its own libraries that break the system python/tk: remove them.
unset LD_PRELOAD LD_LIBRARY_PATH PYTHONHOME PYTHONPATH
HERE="$(dirname "$(readlink -f "$0")")"
PY="$(command -v /usr/bin/python3 || command -v python3)"
export PYTHONDONTWRITEBYTECODE=1
exec "$PY" "$HERE/usr/share/wiisim/wiisim.py" "$@"
